<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SpiceStyle.Base" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.SpiceStyle.Default" parent="Theme.SpiceStyle.Base">
        <item name="nowPlayingBackground">@drawable/now_playing_bg_default</item>
        <item name="nowTextPrimary">@color/now_text_primary</item>
        <item name="nowTextSecondary">@color/now_text_secondary</item>
        <item name="nowButtonBg">@color/now_button_bg</item>
        <item name="nowButtonStroke">@color/now_button_stroke</item>
        <item name="nowAccent">@color/now_accent</item>
    </style>

    <style name="Theme.SpiceStyle.Iceberg" parent="Theme.SpiceStyle.Base">
        <item name="nowPlayingBackground">@drawable/now_playing_bg_iceberg</item>
        <item name="nowTextPrimary">@color/now_text_primary</item>
        <item name="nowTextSecondary">@color/now_text_secondary</item>
        <item name="nowButtonBg">@color/now_button_bg</item>
        <item name="nowButtonStroke">@color/now_button_stroke</item>
        <item name="nowAccent">@color/now_accent</item>
    </style>

</resources>
