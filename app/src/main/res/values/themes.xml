<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- App theme (light & dark handled by DayNight) -->
    <style name="Theme.SpiceStyle" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Status bar tweaks -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- (optional) basic colors so Material has something to use -->
        <item name="colorPrimary">@android:color/black</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

</resources>
