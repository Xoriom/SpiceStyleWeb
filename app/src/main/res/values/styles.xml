<resources>
    <!-- Existing styles ... -->

    <!-- Primary rounded button used in our screens -->
    <style name="Widget.Spice.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/btn_primary_foreground</item>
        <item name="android:textColor">@color/btn_primary_foreground</item>
        <item name="backgroundTint">@color/btn_primary_background</item>
        <item name="rippleColor">@color/btn_primary_ripple</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
    </style>
</resources>
