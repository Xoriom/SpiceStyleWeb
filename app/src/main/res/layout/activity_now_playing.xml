<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/now_playing_bg"
    android:padding="24dp">

    <!-- Album art with rounded corners + subtle stroke -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/coverArt"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/Shape.RoundedXL"
        app:strokeColor="@color/now_button_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintBottom_toTopOf="@+id/title"
        android:contentDescription="@string/album_art" />

    <!-- Title -->
    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Title"
        android:textColor="@color/now_text_primary"
        android:textStyle="bold"
        android:textSize="22sp"
        android:maxLines="2"
        app:layout_constraintTop_toBottomOf="@id/coverArt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="18dp" />

    <!-- Subtitle (artist • album) -->
    <TextView
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Artist • Album"
        android:textColor="@color/now_text_secondary"
        android:textSize="15sp"
        android:maxLines="1"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <!-- Time left -->
    <TextView
        android:id="@+id/elapsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0:00"
        android:textColor="@color/now_text_secondary"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0:00"
        android:textColor="@color/now_text_secondary"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        app:layout_constraintStart_toEndOf="@id/elapsed"
        app:layout_constraintEnd_toStartOf="@id/duration"
        android:layout_marginTop="8dp" />

    <!-- Controls row -->
    <LinearLayout
        android:id="@+id/controlsRow"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/seekBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="18dp">

        <!-- Previous (small circular button) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/prevBtn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="28dp"
            app:icon="@android:drawable/ic_media_previous"
            app:iconPadding="0dp"
            app:iconGravity="textStart"
            app:strokeColor="@color/now_button_stroke"
            app:strokeWidth="1dp"
            android:backgroundTint="@color/now_button_bg"
            android:tint="@color/now_text_primary"
            android:contentDescription="@string/prev" />

        <!-- Play/Pause (large filled circular) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/playPauseBtn"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="36dp"
            app:icon="@android:drawable/ic_media_play"
            app:iconPadding="0dp"
            app:iconGravity="textStart"
            android:backgroundTint="@color/now_accent"
            android:tint="@android:color/white"
            android:contentDescription="@string/play_pause" />

        <!-- Next (small circular button) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextBtn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="28dp"
            app:icon="@android:drawable/ic_media_next"
            app:iconPadding="0dp"
            app:iconGravity="textStart"
            app:strokeColor="@color/now_button_stroke"
            app:strokeWidth="1dp"
            android:backgroundTint="@color/now_button_bg"
            android:tint="@color/now_text_primary"
            android:contentDescription="@string/next" />
    </LinearLayout>

    <!-- Toggles row -->
    <LinearLayout
        android:id="@+id/togglesRow"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/controlsRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shuffleBtn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/shuffle"
            android:textColor="@color/now_text_primary"
            app:strokeColor="@color/now_button_stroke"
            app:strokeWidth="1dp"
            android:backgroundTint="@color/now_button_bg" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/repeatBtn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/repeat"
            android:textColor="@color/now_text_primary"
            app:strokeColor="@color/now_button_stroke"
            app:strokeWidth="1dp"
            android:backgroundTint="@color/now_button_bg" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
